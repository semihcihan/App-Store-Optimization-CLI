---
import iconUrl from "../../../assets/app-icon/aso-icon-readme.png?url";
import { Image } from "astro:assets";
import dashboard from "../../../cli/dashboard-ui/public/dashboard.jpg";
import dashboardUrl from "../../../cli/dashboard-ui/public/dashboard.jpg?url";
import SiteHead from "../components/SiteHead.astro";
import "../styles/site.css";
import { resolveSitePath, resolveSiteUrl, siteOrigin } from "../../site-config.mjs";
import {
  faqEntries,
  featureList,
  installCommand,
  mcpToolName,
  npmUrl,
  projectName,
  repoUrl,
  setupUrl,
  siteDescription,
  siteTitle,
} from "../site-content";

const canonicalUrl = resolveSiteUrl("/");
const ogImageUrl = new URL(dashboardUrl, siteOrigin).toString();
const dashboardAlt = "ASO CLI dashboard showing App Store keyword popularity, difficulty, and ranking results";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${canonicalUrl}#creator`,
      name: "Semih Cihan",
      url: "https://github.com/semihcihan",
    },
    {
      "@type": "WebSite",
      "@id": `${canonicalUrl}#website`,
      url: canonicalUrl,
      name: projectName,
      description: siteDescription,
      publisher: {
        "@id": `${canonicalUrl}#creator`,
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalUrl}#page`,
      url: canonicalUrl,
      name: siteTitle,
      isPartOf: { "@id": `${canonicalUrl}#website` },
      mainEntity: { "@id": `${canonicalUrl}#application` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${canonicalUrl}#application`,
      name: projectName,
      alternateName: "aso-cli",
      url: canonicalUrl,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
      description: siteDescription,
      featureList,
      image: ogImageUrl,
      screenshot: [ogImageUrl],
      downloadUrl: npmUrl,
      sameAs: [npmUrl, repoUrl],
      license: `${repoUrl}/blob/main/LICENSE`,
      softwareRequirements: "Node.js 18.14.1 or later; Apple Search Ads setup",
      creator: {
        "@id": `${canonicalUrl}#creator`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={siteTitle}
      description={siteDescription}
      canonical={canonicalUrl}
      image={{ url: ogImageUrl, alt: dashboardAlt, width: dashboard.width, height: dashboard.height }}
    />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <div class="noise"></div>
    <main class="page">
      <div class="topbar-wrap reveal" style="--delay: 0ms;">
        <header class="topbar section-inner">
          <a class="brand" href="#top">
            <img src={iconUrl} alt="" width="34" height="34" />
            <span>ASO CLI</span>
          </a>
          <nav>
            <a href="#top">Overview</a>
            <a href={resolveSitePath("/mcp/")}>MCP</a>
            <a href="#faq">FAQ</a>
          </nav>
        </header>
      </div>

      <section class="hero band-hero reveal" id="top" style="--delay: 120ms;">
        <div class="section-inner">
          <p class="kicker">FREE AND OPEN SOURCE</p>
          <h1>App Store keyword research with ASO CLI</h1>
          <p class="lede">{siteDescription}</p>

          <div class="cta-stack">
            <div class="install-box" role="group" aria-label="Install ASO CLI">
              <code id="install-command">{installCommand}</code>
              <button
                type="button"
                class="copy-icon-button"
                data-copy={installCommand}
                aria-label="Copy install command"
                title="Copy install command"
              >
                <span class="copy-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18">
                    <rect x="8" y="8" width="14" height="14" rx="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                </span>
                <span class="check-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18">
                    <path d="m6 12 4 4 8-8"></path>
                  </svg>
                </span>
              </button>
            </div>
            <a class="github-cta" href={repoUrl} target="_blank" rel="noreferrer">
              <span class="github-star-count" data-github-stars aria-label="GitHub star count">
                -
              </span>
              <span class="github-mark" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="15" height="15">
                  <path
                    fill="currentColor"
                    d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38
                    0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13
                    -.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66
                    .07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15
                    -.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.64 7.64 0 0 1 4 0c1.53-1.04
                    2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87
                    3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46
                    .55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"
                  ></path>
                </svg>
              </span>
              <span class="github-label">View on GitHub</span>
            </a>
          </div>

          <p class="resource-links">
            <a href={setupUrl}>Apple Search Ads setup</a>
            <a href={npmUrl}>npm package</a>
          </p>
        </div>
      </section>

      <section class="capabilities band-capabilities reveal" style="--delay: 180ms;">
        <div class="section-inner">
          <h2>What ASO CLI helps you evaluate</h2>
          <div class="capability-grid">
            <article class="capability-card">
              <h3>Keyword research</h3>
              <p>
                Score candidate search terms for the US App Store using popularity,
                estimated ranking difficulty, and brand classification.
              </p>
            </article>
            <article class="capability-card">
              <h3>Local analysis</h3>
              <p>
                Run <code>aso</code> to review keyword metrics, inspect search rankings,
                and manage tracked terms in your browser.
              </p>
            </article>
            <article class="capability-card">
              <h3>Automation</h3>
              <p>
                Connect the <a href={resolveSitePath("/mcp/")}>ASO MCP server</a> to an agent
                or read JSON from <code>aso keywords … --stdout</code> in your scripts.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="showcase band-showcase reveal" style="--delay: 240ms;">
        <div class="section-inner">
          <h2>Review keyword metrics in your local ASO dashboard</h2>
          <p>
            Compare terms before updating your App Store metadata. Start with a list of
            candidates from your own research, then use ASO CLI to evaluate them.
          </p>
          <pre><code>{'aso keywords "meditation,sleep sounds,white noise"'}</code></pre>
          <Image
            class="feature-shot"
            src={dashboard}
            alt={dashboardAlt}
            widths={[480, 960, 1440, 2068]}
            sizes="(max-width: 972px) calc(100vw - 2rem), 940px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>

      <section class="mcp band-mcp reveal" id="mcp" style="--delay: 320ms;">
        <div class="section-inner">
          <h2>Evaluate App Store keywords with an MCP client</h2>
          <p>
            The local server runs over standard input and output (stdio). Give
            <code>{mcpToolName}</code> a list of keywords to score and use the results
            to shortlist candidates for your app.
          </p>
          <p class="resource-links">
            <a href={resolveSitePath("/mcp/")}>Set up ASO MCP and try a tool call</a>
          </p>
        </div>
      </section>

      <section class="faq band-faq reveal" id="faq" style="--delay: 380ms;">
        <div class="section-inner">
          <h2>FAQ</h2>
          {faqEntries.map(({ question, answer }) => (
            <article class="faq-item">
              <h3>{question}</h3>
              <p>{answer}</p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <script is:inline>
      const copyButton = document.querySelector("button[data-copy]");
      if (copyButton instanceof HTMLButtonElement) {
        copyButton.addEventListener("click", async () => {
          const value = copyButton.dataset.copy ?? "";
          await navigator.clipboard.writeText(value);
          copyButton.classList.add("is-copied");
          window.setTimeout(() => {
            copyButton.classList.remove("is-copied");
          }, 1200);
        });
      }

      const starCount = document.querySelector("[data-github-stars]");
      if (starCount instanceof HTMLElement) {
        fetch("https://api.github.com/repos/semihcihan/App-Store-Optimization-CLI", {
          headers: {
            Accept: "application/vnd.github+json",
          },
        })
          .then((response) => {
            if (!response.ok) return null;
            return response.json();
          })
          .then((data) => {
            if (typeof data?.stargazers_count !== "number") return;
            starCount.textContent = new Intl.NumberFormat("en-US").format(data.stargazers_count);
          })
          .catch(() => {
            // keep fallback placeholder
          });
      }
    </script>
  </body>
</html>
