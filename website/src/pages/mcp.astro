---
import { Image } from "astro:assets";
import iconUrl from "../../../assets/app-icon/aso-icon-readme.png?url";
import mcpScreenshot from "../../../cli/dashboard-ui/public/mcp.jpg";
import mcpScreenshotUrl from "../../../cli/dashboard-ui/public/mcp.jpg?url";
import SiteHead from "../components/SiteHead.astro";
import "../styles/site.css";
import { resolveSitePath, resolveSiteUrl, siteOrigin } from "../../site-config.mjs";
import {
  installCommand,
  mcpConfig,
  mcpDescription,
  mcpExample,
  mcpTitle,
  mcpToolName,
  repoUrl,
  setupUrl,
} from "../site-content";

const screenshotAlt = "An MCP client using ASO CLI to evaluate App Store keyword candidates";
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={mcpTitle}
      description={mcpDescription}
      canonical={resolveSiteUrl("/mcp/")}
      image={{
        url: new URL(mcpScreenshotUrl, siteOrigin).toString(),
        alt: screenshotAlt,
        width: mcpScreenshot.width,
        height: mcpScreenshot.height,
      }}
    />
  </head>
  <body>
    <div class="noise"></div>
    <div class="page">
      <div class="topbar-wrap">
        <header class="topbar section-inner">
          <a class="brand" href={resolveSitePath("/")}>
            <img src={iconUrl} alt="" width="34" height="34" />
            <span>ASO CLI</span>
          </a>
          <nav>
            <a href={resolveSitePath("/")}>Overview</a>
            <a href={resolveSitePath("/mcp/")} aria-current="page">MCP</a>
            <a href={resolveSitePath("/#faq")}>FAQ</a>
          </nav>
        </header>
      </div>
      <main class="mcp band-mcp guide">
        <article class="section-inner">
          <h1>ASO MCP server for App Store keyword research</h1>
          <p>
            Connect ASO CLI to a Model Context Protocol (MCP) client to score keyword candidates for
            the US App Store. The client launches <code>aso-mcp</code> locally over standard input
            and output (stdio).
          </p>

          <h2>Install and sign in</h2>
          <p>
            You'll need Node.js 18.14.1 or later, Apple Search Ads linked to App Store Connect,
            and the App ID of a published app you can access. Follow the
            <a href={setupUrl}>Apple Search Ads setup guide</a> before authenticating.
          </p>
          <pre><code>{[installCommand, "aso auth"].join("\n")}</code></pre>

          <h2>Connect your MCP client</h2>
          <p>
            If your client uses JSON with an <code>mcpServers</code> key, add this entry.
            Otherwise configure a local stdio server with the command <code>aso-mcp</code>.
            If your client can't find it, use the full path to the installed executable.
          </p>
          <pre><code>{JSON.stringify(mcpConfig, null, 2)}</code></pre>

          <h2>Evaluate keyword candidates</h2>
          <p>
            Call <code>{mcpToolName}</code> with a <code>keywords</code> array. The
            tool scores terms you supply. This example keeps terms with popularity
            of at least 6 and difficulty of at most 70.
          </p>
          <pre><code>{JSON.stringify(mcpExample, null, 2)}</code></pre>
          <p>
            Results include accepted terms with <code>keyword</code>, <code>popularity</code>,
            <code>difficulty</code>, <code>minDifficultyScore</code>, and <code>isBrandKeyword</code>.
            Accepted terms can be saved to the local dashboard. Set <code>appId</code> to choose a
            local app, or omit it to use the Research workspace. Set <code>excludeExisting</code> to
            skip terms the app already tracks.
          </p>
          <p>
            If the tool reports that authentication is required, run <code>aso auth</code> in
            your terminal, then retry the call.
          </p>
          <p>
            <a href={`${repoUrl}#mcp`}>MCP reference on GitHub</a>
          </p>

          <Image
            class="feature-shot"
            src={mcpScreenshot}
            alt={screenshotAlt}
            width={1440}
            widths={[480, 960, 1440]}
            sizes="(max-width: 680px) calc(100vw - 2rem), 650px"
            format="webp"
            loading="lazy"
            decoding="async"
          />
        </article>
      </main>
    </div>
  </body>
</html>
